# ===== LLM（选其一；M0 默认 mock，无需 key 即可离线跑通）=====
# BA_LLM_PROVIDER=mock
# BA_LLM_PROVIDER=deepseek     # 国内，OpenAI 兼容
# BA_LLM_PROVIDER=qwen
# BA_LLM_PROVIDER=zhipu
# BA_LLM_PROVIDER=ollama       # 本地，OpenAI 兼容
# BA_LLM_PROVIDER=openai

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ===== 数据目录（默认 <项目目录>/.local，可用 BA_HOME 改到别处）=====
# BA_HOME=D:\data\banalyse
# BA_RESULTS_DIR=D:\data\banalyse\logs    # 只改报告落盘位置

# ===== 运行期覆盖（BA_* 均可在此设置）=====
# BA_DEEP_THINK_LLM=deepseek-reasoner
# BA_QUICK_THINK_LLM=deepseek-chat
# BA_BACKEND_URL=
# BA_OUTPUT_LANGUAGE=Chinese
# BA_MARKET=global        # global | china
# BA_TEMPERATURE=0.0
# BA_MAX_TOKENS=8192

# ===== 网页端（python -m banalyse.web）=====
# BA_WEB_HOST=127.0.0.1     # 局域网访问用 0.0.0.0
# BA_WEB_PORT=8000
# BA_WEB_TOKEN=             # 设了才需要 X-Web-Token 请求头
# BA_WEB_CONFIG=            # 默认 <项目目录>/.local/web_config.json

# ===== 数据源：单源 SEC EDGAR（免费公开接口）=====
# **必需**：SEC 强制要求请求头带可联系的身份，不给会 403。填你的名字 + 邮箱即可。
# 没配这项 → 所有槽位都取不到数据，哨兵会直接点名缺这个变量。
SEC_EDGAR_USER_AGENT=Your Name your@email.com
# 覆盖供应商链（逗号分隔，顺序即优先级；当前只有 sec_edgar 一家）
# BA_DATA_VENDORS_GLOBAL=sec_edgar
# BA_DATA_VENDORS_CHINA=sec_edgar